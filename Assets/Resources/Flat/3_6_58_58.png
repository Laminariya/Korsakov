	<title>Войти в Битрикс24</title>
	<style>
	.auth-logo-wrapper {
		display: inline-block;
		background: rgba(0, 0, 0, 0.23);  /* чуть темнее фон */
		border-radius: 16px;             /* немного больше скругление */
		padding: 20px 28px;              /* увеличенные отступы */
		backdrop-filter: blur(5px);      /* лёгкое размытие фона */
		box-shadow: 0 4px 20px rgba(0,0,0,0.25); /* тень для глубины */
	}
	
	.auth-logo {
		display: block;
		height: 60px; /* можно подогнать под реальный размер логотипа */
	}
	</style>

	<style>
	  /* Снегопад на всю страницу */
	  #snowfall-canvas {
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100vh;
		pointer-events: none;
		z-index: 999999; /* поверх всего */
	  }
	
	  /* “Сугробы” поверх конкретных элементов */
	  .snow-cap-canvas {
		position: fixed;         /* именно fixed: не требует position:relative у элементов */
		pointer-events: none;
		z-index: 1000000;
	  }
</style>
</head>


